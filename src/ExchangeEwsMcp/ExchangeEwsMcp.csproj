<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>ExchangeEwsMcp</RootNamespace>
    <InvariantGlobalization>false</InvariantGlobalization>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <UserSecretsId>exchange-ews-mcp</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Exchange.WebServices.NETCore" Version="3.3.1" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.14" />
    <PackageReference Include="ModelContextProtocol.AspNetCore" Version="2.3.0" />
    <PackageReference Include="PdfPig" Version="0.1.16" />
    <!-- Pin patched versions of transitive dependencies of Exchange.WebServices.NETCore. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.14" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ExchangeEwsMcp.Tests" />
  </ItemGroup>

</Project>
